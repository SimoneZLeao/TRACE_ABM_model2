OPPORTUNITIES</note>
    <note x="20" y="410" backgroundDark="0" fontSize="12" width="115" markdown="false" height="40" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">SECONDARY JOBS</note>
    <button x="556" y="530" height="40" disableUntilTicks="false" forever="true" kind="Observer" display="Go (to end)" width="210" sizeVersion="0">go</button>
    <plot x="780" autoPlotX="true" yMax="10.0" autoPlotY="true" y="247" xMin="0.0" height="180" legend="false" xMax="10.0" yMin="0.0" display="Mean EC" width="180" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="MEAN" color="-2674135" legend="true">
        <setup></setup>
        <update>plot mean [EC] of turtles with [state = "Active"]</update>
      </pen>
    </plot>
    <plot x="965" autoPlotX="true" yMax="10.0" autoPlotY="true" y="247" xMin="0.0" height="180" legend="false" xMax="10.0" yMin="0.0" display="Mean SC-gains" width="180" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="pen-1" color="-2674135" legend="true">
        <setup></setup>
        <update>plot mean [SC-gain] of turtles with [state = "Active"]</update>
      </pen>
    </plot>
    <plot x="1150" autoPlotX="true" yMax="1.0" autoPlotY="true" y="247" xMin="0.0" height="180" legend="false" xMax="10.0" yMin="0.0" width="180" display="Mean-EC (x) vs Mean-SC (y)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Mean EC vs Mean SC" color="-13791810" legend="true">
        <setup></setup>
        <update></update>
      </pen>
    </plot>
    <plot x="1335" autoPlotX="true" yMax="10.0" autoPlotY="true" y="247" xMin="0.0" height="180" legend="false" xMax="10.0" yMin="0.0" display="Mean SR-gains" width="180" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-2674135" legend="true">
        <setup></setup>
        <update>plot mean [SR-gain] of turtles with [state = "Active"]</update>
      </pen>
