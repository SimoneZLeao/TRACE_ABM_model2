<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CREATIVE CAREER TRAJECTORIES MODEL
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  ;; BATCH SIMULATION
  batch-run-number
  batch-mode?

  simulation-length
  initial-SC
  min-disposition
  max-disposition
  K
  SC-min
  SC-max

  ;; INITIAL ECONOMIC CAPITAL
  initial-EC-min
  initial-EC-max
  
  ;; SELF-REALISATION PARAMETERS
  initial-SR
  self-realisation-propensity-min
  self-realisation-propensity-max

  ;; SECONDARY JOB PARAMETER RANGES
  secondary-job-hours-min
  secondary-job-hours-max
  secondary-job-wage-min
  secondary-job-wage-max
  secondary-job-duration-min
  secondary-job-duration-max
  
  ;; WORKING HOURS
  H-max
  H-extra-max

  ;; EXIT AND VISUALISATION THRESHOLDS
  artists-exited-this-tick
  returns-this-tick

  T-cyan
  T-green
  T-yellow
  T-red

  ;; FILE MANAGEMENT
  simulation-file-name
  configuration-file-name
]

;; ARTIST ATTRIBUTES
turtles-own [
  EC
  SC
  state
  job-seeker?
  secondary-job-type
  secondary-job-hours
  secondary-job-wage
  secondary-job-duration
  secondary-job-remaining
  job-EC-gain
  artistic-hours
  extra-artistic-hours

  self-realisation-propensity
  SR
  SR-gain

  investment-disposition

  investment-amount
  recognition-event
  SC-gain
  economic-event
  EC-gain

  exit-count
  return-count
  secondary-job-count
]

;;====================================================
;; SETUP
;;====================================================

to setup

  ;; Preserve batch settings before clear-all.
  let saved-batch-mode false
  if is-boolean? batch-mode? [
    set saved-batch-mode batch-mode?
  ]
  let saved-batch-run-number batch-run-number

  clear-all

  set batch-mode? saved-batch-mode
  set batch-run-number saved-batch-run-number

  ;; MODEL PARAMETERS
  set number-artists number-artists
  set simulation-length 260
  set K 20000

  ;; WORKING HOURS
  set H-max 42
  set H-extra-max 0
  
  ;; SELF-REALISATION PARAMETERS
  set initial-SR 0
  set self-realisation-propensity-min 0.2
  set self-realisation-propensity-max 1.0

  ;; SECONDARY JOB PARAMETER RANGES
  set secondary-job-hours-min 5
  set secondary-job-hours-max 42
  set secondary-job-wage-min 50
  set secondary-job-wage-max 120
  set secondary-job-duration-min 2
  set secondary-job-duration-max 13

  ;; INITIAL ECONOMIC CAPITAL
  set initial-EC-min 23200
  set initial-EC-max 50000

  ;; EXIT AND VISUALISATION THRESHOLDS
  set T-cyan 50000
  set T-green 42000
  set T-yellow 23200
  set T-red 10000

  ;; CREATE ARTISTS
  ask n-of number-artists patches [
    sprout 1 [
      set initial-SC 0

      set EC initial-EC-min +
        random-float (initial-EC-max - initial-EC-min)

      set SC initial-SC
      set state "Active"
      set job-seeker? false

      set investment-amount 0
      set recognition-event false
      set SC-gain 0
      set economic-event false
      set EC-gain 0

      set min-disposition 0.20
      set max-disposition 0.60

      set SC-min 40
      set SC-max 120

      set investment-disposition
        min-disposition +
        random-float (max-disposition - min-disposition)

      set secondary-job-type ""
      set secondary-job-hours 0
      set secondary-job-wage 0
      set secondary-job-duration 0
      set secondary-job-remaining 0
      set job-EC-gain 0

      set artistic-hours 42
      set extra-artistic-hours 0

      set self-realisation-propensity
        self-realisation-propensity-min +
        random-float
        (self-realisation-propensity-max -
         self-realisation-propensity-min)

      set SR initial-SR
      set SR-gain 0

      set exit-count 0
      set return-count 0
      set secondary-job-count 0

      set shape "circle"
      set color green
      set size 0.8
    ]
  ]

  ;; FILE NAMES
  ifelse batch-mode? [

    set simulation-file-name
      (word
        "C:/Users/zleao/Dropbox/PC/Desktop/My PhD Adelaide 2026/1 TRACE abm model/NetLogo Model/TRACE Model/simulation_data_"
        batch-run-number
        ".csv")

    set configuration-file-name
      (word
        "C:/Users/zleao/Dropbox/PC/Desktop/My PhD Adelaide 2026/1 TRACE abm model/NetLogo Model/TRACE Model/model_configuration_"
        batch-run-number
        ".csv")

  ] [

    set simulation-file-name
      "C:/Users/zleao/Dropbox/PC/Desktop/My PhD Adelaide 2026/1 TRACE abm model/NetLogo Model/TRACE Model/simulation_data.csv"

    set configuration-file-name
      "C:/Users/zleao/Dropbox/PC/Desktop/My PhD Adelaide 2026/1 TRACE abm model/NetLogo Model/TRACE Model/model_configuration.csv"
  ]

  file-close-all

  ;; Start fresh files for this run.
  if file-exists? simulation-file-name [
    file-delete simulation-file-name
  ]
  if file-exists? configuration-file-name [
    file-delete configuration-file-name
  ]

  file-open simulation-file-name

  file-print "Tick,ArtistID,EC,SC,SR,State,Colour,InvestmentDisposition,SelfRealisationPropensity,Investment,RecognitionEvent,SCGain,EconomicEvent,ECGain,SRGain,JobSeeker,SecondaryJobType,SecondaryJobHours,SecondaryJobHourlyWage,SecondaryJobDuration,JobECGain,ArtisticHours,ExitCount,ReturnCount,SecondaryJobCount"

  file-close

  record-configuration

  clear-all-plots
  reset-ticks

end

;;====================================================
;; GO
;;====================================================

to go

  if ticks >= simulation-length [
    file-close-all
    stop
  ]

  set artists-exited-this-tick 0
  set returns-this-tick 0

  reset-events
  check-re-entry

  ask turtles [
    if secondary-job-remaining = 0 [
      set job-EC-gain 0
      set secondary-job-type ""
      set secondary-job-hours 0
      set secondary-job-wage 0
      set secondary-job-duration 0
    ]
  ]

  update-artistic-hours
  calculate-self-realisation

  invest-in-practice
  allocate-recognition
  allocate-economic-opportunities
  withdrawal-from-field
  check-job-seeker

  match-secondary-jobs
  update-job-EC-gain

  update-colours
  record-data
  update-population-plot
  update-capital-space-plot

  tick

end

;;====================================================
;; SUB-MODEL 1: INVESTMENT
;;====================================================

to invest-in-practice

  ask turtles with [state = "Active"] [
    set investment-amount
      Imin +
      investment-disposition *
      (Imax - Imin) *
      (1 - exp (- EC / K))

    set EC EC - investment-amount
  ]

end

;;====================================================
;; SUB-MODEL 2: CHECK NEED FOR SECONDARY JOB
;;====================================================

to check-job-seeker

  ask turtles [

    ifelse secondary-job-remaining > 0 [
      set job-seeker? false
    ] [
      ifelse state = "Exited" [
        set job-seeker? true
      ] [
        ifelse EC < (10 * investment-amount) [
          set job-seeker? true
        ] [
          set job-seeker? false
        ]
      ]
    ]
  ]

end

;;====================================================
;; CHECK RE-ENTRY INTO THE FIELD
;;====================================================

to check-re-entry

  ask turtles with [state = "Exited"] [
    if EC >= Imin [
      set state "Active"
      set return-count return-count + 1
      set returns-this-tick returns-this-tick + 1
    ]
  ]

end

;;====================================================
;; MATCH SECONDARY JOBS
;;====================================================

to match-secondary-jobs

  let job-seekers turtles with [job-seeker?]

  repeat secondary-jobs-per-tick [

    if any? job-seekers [

      let job-type ifelse-value
        (random-float 1 < cultural-job-probability)
        ["Cultural"]
        ["Non-cultural"]

      let job-hours
        secondary-job-hours-min +
        random
        (secondary-job-hours-max -
         secondary-job-hours-min + 1)

      let job-wage
        secondary-job-wage-min +
        random-float
        (secondary-job-wage-max -
         secondary-job-wage-min)

      let job-duration
        secondary-job-duration-min +
        random
        (secondary-job-duration-max -
         secondary-job-duration-min + 1)

      let selected-artist nobody

      ifelse job-type = "Cultural" [

        let total-weight sum [1 + sqrt SC] of job-seekers
        let random-value random-float total-weight
        let cumulative-weight 0

        ask job-seekers [
          if selected-artist = nobody [
            set cumulative-weight
              cumulative-weight + (1 + sqrt SC)

            if cumulative-weight >= random-value [
              set selected-artist self
            ]
          ]
        ]

      ] [

        set selected-artist one-of job-seekers

      ]

      if selected-artist != nobody [

        ask selected-artist [
          set job-seeker? false
          set secondary-job-type job-type
          set secondary-job-hours job-hours
          set secondary-job-wage job-wage
          set secondary-job-duration job-duration
          set secondary-job-remaining secondary-job-duration
          set job-EC-gain secondary-job-hours * secondary-job-wage
          set secondary-job-count secondary-job-count + 1

          if state = "Active" [
            set artistic-hours 42 - secondary-job-hours
          ]
        ]

        set job-seekers
          job-seekers with [self != selected-artist]
      ]
    ]
  ]

end

;;====================================================
;; UPDATE ARTISTIC HOURS
;;====================================================

to update-artistic-hours

  ask turtles [

    ifelse state = "Active" [

      let basic-artistic-hours H-max - secondary-job-hours

      ifelse basic-artistic-hours <= 10 and H-extra-max > 0 [
        set extra-artistic-hours random (H-extra-max + 1)
      ] [
        set extra-artistic-hours 0
      ]

      set artistic-hours
        basic-artistic-hours + extra-artistic-hours

    ] [

      set artistic-hours 0
      set extra-artistic-hours 0

    ]
  ]

end

;;====================================================
;; CALCULATE SELF-REALISATION
;;====================================================

to calculate-self-realisation

  ask turtles with [state = "Active"] [
    set SR-gain artistic-hours * self-realisation-propensity
    set SR SR + SR-gain
  ]

end

;;====================================================
;; UPDATE JOB ECONOMIC GAIN
;;====================================================

to update-job-EC-gain

  ask turtles with [secondary-job-remaining > 0] [

    if secondary-job-remaining < secondary-job-duration [
      set EC EC + job-EC-gain
    ]

    set secondary-job-remaining secondary-job-remaining - 1
  ]

end

;;====================================================
;; SUB-MODEL 3: ALLOCATE RECOGNITION
;;====================================================

to allocate-recognition

  let active-artists turtles with [state = "Active"]

  if any? active-artists [

    repeat recognition-opportunities [

      let participating-artists active-artists with [
        random-float 1 < artistic-hours / 42
      ]

      if any? participating-artists [

        let total-weight sum [1 + sqrt SC] of participating-artists

        let selected-artist nobody
        let random-value random-float total-weight
        let cumulative-weight 0

        ask participating-artists [

          if selected-artist = nobody [

            set cumulative-weight
              cumulative-weight + (1 + sqrt SC)

            if cumulative-weight >= random-value [
              set selected-artist self
            ]
          ]
        ]

        if selected-artist != nobody [

          ask selected-artist [

            let gain random-float (SC-max - SC-min) + SC-min

            set SC SC + gain
            set recognition-event true
            set SC-gain SC-gain + gain

          ]
        ]
      ]
    ]
  ]

end

;;====================================================
;; SUB-MODEL 4: ALLOCATE ECONOMIC OPPORTUNITIES
;;====================================================

to allocate-economic-opportunities

  let active-artists turtles with [state = "Active"]

  if any? active-artists [

    repeat economic-opportunities [

      let total-weight sum [1 + sqrt SC] of active-artists

      let selected-artist nobody
      let random-value random-float total-weight
      let cumulative-weight 0

      ask active-artists [

        if selected-artist = nobody [

          set cumulative-weight
            cumulative-weight + (1 + sqrt SC)

          if cumulative-weight >= random-value [
            set selected-artist self
          ]
        ]
      ]

      if selected-artist != nobody [

        ask selected-artist [

          let gain random-float (EC-max - EC-min) + EC-min

          set EC EC + gain
          set economic-event true
          set EC-gain EC-gain + gain

        ]
      ]
    ]
  ]

end

;;====================================================
;; SUB-MODEL 5: WITHDRAWAL FROM FIELD
;;====================================================

to withdrawal-from-field

  ask turtles with [state = "Active"] [

    if EC < Imin [

      set state "Exited"
      set exit-count exit-count + 1
      set artistic-hours 0
      set extra-artistic-hours 0

      if EC < 0 [
        set EC 0
      ]

      set artists-exited-this-tick
        artists-exited-this-tick + 1

      set job-seeker? true
    ]
  ]

end

;;====================================================
;; UPDATE COLOURS
;;====================================================

to update-colours

  ask turtles [

    if state = "Exited" [
      set color black
    ]

    if state = "Active" [

      if EC >= T-cyan [
        set color blue
      ]

      if EC >= T-green and EC < T-cyan [
        set color cyan
      ]

      if EC >= T-yellow and EC < T-green [
        set color green
      ]

      if EC >= T-red and EC < T-yellow [
        set color yellow
      ]

      if EC < T-red [
        set color red
      ]
    ]
  ]

end

;;====================================================
;; RECORD DATA
;;====================================================

to record-data

  file-open simulation-file-name

  ask turtles [

    file-print
      (word
        ticks ","
        who ","
        precision EC 2 ","
        precision SC 2 ","
        precision SR 2 ","
        state ","
        color-name ","
        precision investment-disposition 2 ","
        precision self-realisation-propensity 2 ","
        precision investment-amount 2 ","
        recognition-event ","
        precision SC-gain 2 ","
        economic-event ","
        precision EC-gain 2 ","
        precision SR-gain 2 ","
        job-seeker? ","
        secondary-job-type ","
        precision secondary-job-hours 2 ","
        precision secondary-job-wage 2 ","
        secondary-job-duration ","
        (ifelse-value secondary-job-duration > 0
          [precision job-EC-gain 2]
          [""]) ","
        precision artistic-hours 2 ","
        exit-count ","
        return-count ","
        secondary-job-count
      )
  ]

  file-close

end

;;====================================================
;; FINISH AND CLOSE FILES
;;====================================================

to finish
  file-close-all
end

;;====================================================
;; SAVE SIMULATION CONFIGURATION
;;====================================================

to record-configuration

  file-open configuration-file-name

  file-print "NumberArtists,SimulationLength,RecognitionOpportunities,EconomicOpportunities,SecondaryJobsPerTick,CulturalJobProbability,InitialEC-min,InitialEC-max,InitialSC,InitialSR,SC-min,SC-max,EC-min,EC-max,MinDisposition,MaxDisposition,Imin,Imax,K,T-cyan,T-green,T-yellow,T-red,H-max,H-extra-max,SelfRealisationPropensity-min,SelfRealisationPropensity-max,SecondaryJobHours-min,SecondaryJobHours-max,SecondaryJobWage-min,SecondaryJobWage-max,SecondaryJobDuration-min,SecondaryJobDuration-max"

  file-print
    (word
      number-artists ","
      simulation-length ","
      recognition-opportunities ","
      economic-opportunities ","
      secondary-jobs-per-tick ","
      cultural-job-probability ","
      initial-EC-min ","
      initial-EC-max ","
      initial-SC ","
      initial-SR ","
      SC-min ","
      SC-max ","
      EC-min ","
      EC-max ","
      min-disposition ","
      max-disposition ","
      Imin ","
      Imax ","
      K ","
      T-cyan ","
      T-green ","
      T-yellow ","
      T-red ","
      H-max ","
      H-extra-max ","
      self-realisation-propensity-min ","
      self-realisation-propensity-max ","
      secondary-job-hours-min ","
      secondary-job-hours-max ","
      secondary-job-wage-min ","
      secondary-job-wage-max ","
      secondary-job-duration-min ","
      secondary-job-duration-max
    )

  file-close

end

;;====================================================
;; REPORT COLOUR NAME
;;====================================================

to-report color-name

  if color = blue [ report "Blue" ]
  if color = cyan [ report "Cyan" ]
  if color = green [ report "Green" ]
  if color = yellow [ report "Yellow" ]
  if color = red [ report "Red" ]
  if color = black [ report "Black" ]

end

;;====================================================
;; RESET EVENTS
;;====================================================

to reset-events

  ask turtles [
    set recognition-event false
    set SC-gain 0
    set economic-event false
    set EC-gain 0
    set SR-gain 0
  ]

end

;;====================================================
;; PLOT NUMBER OF ACTIVE ARTISTS BY CAPITAL STATUS
;;====================================================

to update-population-plot

  set-current-plot "Artists by Status"
  auto-plot-on

  set-current-plot-pen "Blue"
  plot count turtles with
    [state = "Active" and EC >= T-cyan]

  set-current-plot-pen "Cyan"
  plot count turtles with
    [state = "Active" and EC >= T-green and EC < T-cyan]

  set-current-plot-pen "Green"
  plot count turtles with
    [state = "Active" and EC >= T-yellow and EC < T-green]

  set-current-plot-pen "Yellow"
  plot count turtles with
    [state = "Active" and EC >= T-red and EC < T-yellow]

  set-current-plot-pen "Red"
  plot count turtles with
    [state = "Active" and EC < T-red]

end

;;====================================================
;; RESET MODEL PARAMETERS TO DEFAULT VALUES
;;====================================================

to default-setup

  set number-artists 1089
  set simulation-length 260
  set initial-SC 0

  set min-disposition 0.20
  set max-disposition 0.60
  set Imin 500
  set Imax 2000
  set K 20000

  set recognition-opportunities 200
  set SC-min 40
  set SC-max 120

  set economic-opportunities 150
  set EC-min 1000
  set EC-max 5000

  set secondary-jobs-per-tick 25
  set cultural-job-probability 0.57

  setup

end

;;====================================================
;; PLOT MEAN SC VS MEAN EC CAPITAL SPACE TRAJECTORY
;;====================================================

to update-capital-space-plot

  set-current-plot "Mean-EC (x) vs Mean-SC (y)"
  set-current-plot-pen "Mean EC vs Mean SC"

  let active-artists turtles with [state = "Active"]

  if any? active-artists [

    let mean-SC mean [SC] of active-artists
    let mean-EC mean [EC] of active-artists

    plotxy mean-EC mean-SC

  ]

end

;;====================================================
;; RUN MODEL 100 TIMES
;;====================================================

to run-100-simulations

  set batch-mode? true
  set batch-run-number 0

  repeat 100 [

    set batch-run-number batch-run-number + 1

    random-seed (1000 + batch-run-number)

    setup

    while [ticks < simulation-length] [
      go
    ]

    file-close-all
  ]

  set batch-mode? false

  print "TRACE-V2 batch complete: 100 simulations saved."

end]]></code>
