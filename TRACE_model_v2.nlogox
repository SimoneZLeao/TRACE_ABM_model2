    <slider x="140" step="1" y="254" max="500" display="recognition-opportunities" height="33" min="0" direction="Horizontal" default="200.0" variable="recognition-opportunities" width="185" sizeVersion="0"></slider>
    <slider x="140" step="1" y="215" max="5000" display="Imax" height="33" min="1" direction="Horizontal" default="1500.0" variable="Imax" width="185" sizeVersion="0"></slider>
