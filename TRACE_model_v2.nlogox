    <slider x="140" step="1" y="140" max="1089" display="number-artists" height="33" min="1" direction="Horizontal" default="1089.0" variable="number-artists" width="185" sizeVersion="0"></slider>
    <slider x="140" step="1" y="365" max="10000" display="EC-max" height="33" min="1" direction="Horizontal" default="2500.0" variable="EC-max" width="185" sizeVersion="0"></slider>
